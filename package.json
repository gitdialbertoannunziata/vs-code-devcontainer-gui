{
  "name": "vs-code-devcontainer-gui",
  "displayName": "Devcontainer GUI",
  "description": "Manage Docker Compose-based devcontainer settings with ease.",
  "version": "0.0.1",
  "publisher": "gitdialbertoannunziata",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitdialbertoannunziata/vs-code-devcontainer-gui"
  },
  "bugs": {
    "url": "https://github.com/gitdialbertoannunziata/vs-code-devcontainer-gui/issues"
  },
  "homepage": "https://github.com/gitdialbertoannunziata/vs-code-devcontainer-gui#readme",
  "keywords": [
    "devcontainer",
    "dev containers",
    "docker compose",
    "docker",
    "remote development"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.devcontainer/devcontainer.json",
    "workspaceContains:.devcontainer.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devcontainerGui",
          "title": "Devcontainer",
          "icon": "resources/devcontainer.svg"
        }
      ]
    },
    "views": {
      "devcontainerGui": [
        {
          "id": "devcontainerGui.configView",
          "name": "Resolved Configuration"
        }
      ]
    },
    "commands": [
      {
        "command": "devcontainerGui.refresh",
        "title": "Devcontainer: Refresh Configuration",
        "icon": "$(refresh)"
      },
      {
        "command": "devcontainerGui.startService",
        "title": "Devcontainer: Start Service",
        "icon": "$(play)"
      },
      {
        "command": "devcontainerGui.stopService",
        "title": "Devcontainer: Stop Service",
        "icon": "$(stop)"
      },
      {
        "command": "devcontainerGui.restartService",
        "title": "Devcontainer: Restart Service",
        "icon": "$(sync)"
      },
      {
        "command": "devcontainerGui.viewLogs",
        "title": "Devcontainer: Show Service Logs",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devcontainerGui.refresh",
          "when": "view == devcontainerGui.configView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "devcontainerGui.startService",
          "when": "view == devcontainerGui.configView && viewItem == devcontainerGuiService",
          "group": "inline@1"
        },
        {
          "command": "devcontainerGui.stopService",
          "when": "view == devcontainerGui.configView && viewItem == devcontainerGuiService",
          "group": "inline@2"
        },
        {
          "command": "devcontainerGui.restartService",
          "when": "view == devcontainerGui.configView && viewItem == devcontainerGuiService",
          "group": "inline@3"
        },
        {
          "command": "devcontainerGui.viewLogs",
          "when": "view == devcontainerGui.configView && viewItem == devcontainerGuiService",
          "group": "inline@4"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.2.1",
    "yaml": "^2.4.5"
  }
}
